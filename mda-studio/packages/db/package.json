{
  "name": "@mda-studio/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "generate": "echo 'drizzle-kit generate (wired in Phase 1.1 follow-up)' && exit 0",
    "migrate": "echo 'drizzle-kit migrate (wired in Phase 1.1 follow-up)' && exit 0"
  },
  "dependencies": {
    "@mda-studio/shared": "workspace:*",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
